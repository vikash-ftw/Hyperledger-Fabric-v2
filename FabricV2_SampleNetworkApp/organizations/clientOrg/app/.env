PORT=8000
CORS_ORIGIN=*

ORG_DOMAIN_NAME=example.com

CA_ADMIN_USERID=admin
CA_ADMIN_USER_PASSWORD=adminpw

ORG_MSP=Org1MSP
ORG_USER_ID=fabricUser

# For Cert Renewal : set it to 'true' when certs are renewed (ONLY ONE TIME)
# Then set it to 'false' immediately after renewal
RE_ENROLL_USER_ID=false

CHANNEL_NAME=samplechannel

# Choose Either One based on your smartcontract type
# CHAINCODE_NAME=fabricSmartContractGo    # uncomment this when using Go based smartcontract
CHAINCODE_NAME=fabricSmartContractNode  # uncomment this when using Node based smartcontract

# Off-chain configs
ALLOW_OFFCHAIN_SYNC=false
# Off-chain DB Address
OFFCHAIN_MONGODB_ADDRESS=mongodb://localhost:27017
OFFCHAIN_MONGODB_DATABASE=fabric_offchain
COUNTER_COLLECTION=nextBlock_counter